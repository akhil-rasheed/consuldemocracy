# Docker image
# Name of the image repository to deploy.
KAMAL_IMAGE=example/consuldemocracy

# SSH connection
# User account used to connect to the deployment server.
KAMAL_SSH_USER=ubuntu

# Path to the private SSH key used for deployment.
KAMAL_SSH_KEY_PATH=/path/to/ssh/private-key

# Server configuration
# Public IP address or hostname of the application server.
KAMAL_HOST=203.0.113.10

# Public domain used by Kamal Proxy for HTTPS routing.
KAMAL_PROXY_HOST=consul.example.com

# Docker registry
# Username for the registry where the application image is stored.
KAMAL_REGISTRY_USERNAME=example-user

# Password or access token for the Docker registry.
KAMAL_REGISTRY_PASSWORD=replace-with-registry-token

# Rails application
# Rails secret key base. Generate with: bundle exec rails secret
SECRET_KEY_BASE=replace-with-generated-secret

# PostgreSQL
# Hostname of the PostgreSQL accessory on the Kamal Docker network.
DB_HOST=example-db

# PostgreSQL database name used by the Rails application.
PGDATABASE=consul_production

# PostgreSQL database user.
PGUSER=consul

# PostgreSQL password used by the Rails application.
PGPASSWORD=replace-with-database-password

# PostgreSQL accessory
# Database name created when the PostgreSQL container is first initialized.
POSTGRES_DB=consul_production

# Database user created when the PostgreSQL container is first initialized.
POSTGRES_USER=consul

# Password for the PostgreSQL accessory.
POSTGRES_PASSWORD=replace-with-database-password

# Deployment settings
# Docker image architecture, e.g. amd64 or arm64.
KAMAL_BUILD_ARCH=arm64

# PostgreSQL Docker image version.
POSTGRES_VERSION=16

# Memcached
# TCP port used by Memcached.
MEMCACHED_PORT=11211

# Maximum memory available to Memcached, in MB.
MEMCACHED_MEMORY_LIMIT=64

# Maximum simultaneous connections.
MEMCACHED_CONNECTIONS=1024

# SMTP configuration
# SMTP server hostname.
SMTP_ADDRESS=smtp.example.com

# SMTP server port (587 for STARTTLS, 465 for implicit TLS).
SMTP_PORT=587

# Domain used for SMTP authentication and HELO identification.
SMTP_DOMAIN=example.com

# SMTP authentication username.
SMTP_USERNAME=your-smtp-username

# SMTP authentication password.
SMTP_PASSWORD=your-smtp-password

# SMTP authentication mechanism (plain, login, or cram_md5).
SMTP_AUTHENTICATION=plain

# Enable automatic STARTTLS negotiation.
SMTP_ENABLE_STARTTLS_AUTO=true

# Rails mail delivery method.
MAILER_DELIVERY_METHOD=smtp
