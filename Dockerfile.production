# syntax=docker/dockerfile:1

ARG RUBY_VERSION=3.4.11
ARG NODE_VERSION=22.23.3

# Node.js build dependencies
FROM node:${NODE_VERSION}-trixie AS node

# ------------------------------------------------------------
# Build stage
# ------------------------------------------------------------
FROM ruby:${RUBY_VERSION}-trixie AS build

ENV DEBIAN_FRONTEND=noninteractive \
    RAILS_ROOT=/var/www/consul \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT="development:test" \
    BUNDLE_DEPLOYMENT=1 \
    BUNDLE_FROZEN=1

WORKDIR $RAILS_ROOT

# Native dependencies required to compile gems and assets.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libpq-dev \
    pkg-config \
    imagemagick \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js and npm for asset compilation.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm

RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm

# Install Ruby dependencies separately to improve build caching.
COPY Gemfile Gemfile.lock Gemfile_custom ./
COPY .ruby-version ./

RUN test "$(cat .ruby-version)" = "${RUBY_VERSION}" \
    && bundle install --jobs=4 --retry=3

# Install JavaScript dependencies.
COPY package.json package-lock.json ./

RUN npm ci --no-audit --no-fund

# Copy application source.
COPY . .

ENV RAILS_ENV=production \
    RACK_ENV=production

# Provide a database configuration for asset compilation.
# This is build-time configuration, not the production database configuration.
RUN cp config/database.yml.example config/database.yml

# Compile assets without requiring production credentials or database initialisation.
RUN APARTMENT_DISABLE_INIT=true \
    SECRET_KEY_BASE_DUMMY=1 \
    bundle exec rails assets:precompile


# ------------------------------------------------------------
# Production stage
# ------------------------------------------------------------
FROM ruby:${RUBY_VERSION}-trixie AS production

ENV DEBIAN_FRONTEND=noninteractive \
    RAILS_ROOT=/var/www/consul \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT="development:test" \
    BUNDLE_DEPLOYMENT=1 \
    BUNDLE_FROZEN=1 \
    RAILS_ENV=production \
    RACK_ENV=production \
    RAILS_SERVE_STATIC_FILES=true \
    RAILS_LOG_TO_STDOUT=true \
    PORT=3000

WORKDIR $RAILS_ROOT

# Install runtime libraries only.
RUN apt-get update && apt-get install -y --no-install-recommends \
    imagemagick \
    libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 app \
    && useradd --system \
        --uid 10001 \
        --gid app \
        --home-dir $RAILS_ROOT \
        --shell /usr/sbin/nologin \
        app \
    && mkdir -p tmp/pids tmp/cache log storage \
    && chown -R app:app $RAILS_ROOT

# Copy installed Ruby dependencies.
COPY --from=build /usr/local/bundle /usr/local/bundle

# Copy application source and compiled assets.
COPY --from=build --chown=app:app $RAILS_ROOT $RAILS_ROOT

# Run the application without root privileges.
USER app

EXPOSE 3000

STOPSIGNAL SIGTERM

ENTRYPOINT []

CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0", "-p", "3000"]
